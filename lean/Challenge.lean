import Mathlib

/-!
# Challenge: the statements of Theorem A (runs of Keiper-Li signs), definitions and `sorry` proofs only

This file is the trusted statement file for `lake comparator` (see COMPARATOR.md).  It imports Mathlib
only, not the solution.  Every definition below is copied verbatim from the solution (`Defs.lean`, and the
grid data of the `Numerics*C*.lean` chunk modules, generated by `gen_challenge.py`), because the
comparator requires each constant a statement depends on to be identical in both environments.

The four hypotheses of each theorem are: `RiemannHypothesis`, `LiSecondDiff c`, `LiWeightSum`,
`ZeroIntervals 2000 loQ hiQ` (2000 rational intervals `[(N_k - 1025)/2^30, (N_k + 1025)/2^30]`, each
containing the ordinate of a zero of zeta on the critical line).  Conclusion: every window of 622 (resp.
711) consecutive `n >= 1` has an `n` with `c n > 0` and an `n` with `c n < 0`; the `_runs` form says that no
window of 622 has all `c n >= 0` or all `c n <= 0`.
-/

open Complex Finset

namespace KeiperComb

noncomputable section

/-- Nontrivial zeros of `riemannZeta`, exactly the side conditions of Mathlib's
`RiemannHypothesis`. -/
def IsNontrivialZero (s : ℂ) : Prop :=
  riemannZeta s = 0 ∧ (¬ ∃ n : ℕ, s = -2 * (n + 1)) ∧ s ≠ 1

open Classical in
/-- Multiplicity of a nontrivial zero (order of vanishing), `0` elsewhere. -/
def zetaMult (ρ : ℂ) : ℕ :=
  if IsNontrivialZero ρ then analyticOrderNatAt riemannZeta ρ else 0

/-- Li's formula, second-difference form (literature-shaped, unconditional): for `n ≥ 1`,
`-c_n = ∑_ρ m_ρ (1 - 1/ρ)^(n-1) / ρ^2`, an unconditionally (hence absolutely) summable family. -/
def LiSecondDiff (c : ℕ → ℝ) : Prop :=
  ∀ n : ℕ, 1 ≤ n →
    HasSum (fun ρ : ℂ => (zetaMult ρ : ℂ) * (1 - 1 / ρ) ^ (n - 1) / ρ ^ 2) (-(c n : ℂ))

/-- Li's weight sum: `∑_ρ m_ρ / (ρ (1 - ρ)) = 2 + γ_E - log (4 π)` (twice `λ_1`). -/
def LiWeightSum : Prop :=
  HasSum (fun ρ : ℂ => (zetaMult ρ : ℂ) / (ρ * (1 - ρ)))
    ((2 + Real.eulerMascheroniConstant - Real.log (4 * Real.pi) : ℝ) : ℂ)

/-- The 2000 (here `K`) certified zero intervals, as a Prop: each rational interval contains the
ordinate `γ` of a zero `1/2 + iγ` of `riemannZeta`.  Nothing more (not "exactly one"). -/
def ZeroIntervals (K : ℕ) (lo hi : ℕ → ℚ) : Prop :=
  ∀ k, k < K → ∃ γ : ℝ, (lo k : ℝ) ≤ γ ∧ γ ≤ (hi k : ℝ) ∧
    riemannZeta (1 / 2 + (γ : ℂ) * I) = 0

end
end KeiperComb

